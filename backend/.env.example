# ==========================================================
# EJEMPLO de backend/.env (copiar como .env y completar)
# Este archivo sí se sube a GitHub: NO tiene valores reales.
# ==========================================================

# Base de datos (local o MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/trazabilidad_agricola

# Clave para firmar las sesiones: texto largo y aleatorio
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

PORT=5000

# Dirección del frontend (QR y enlace de la norma en el certificado)
QR_FRONTEND_URL=http://localhost:5173

# Datos de la empresa que aparecen en el sistema y en el certificado
EMPRESA_NOMBRE=
EMPRESA_RUC=
EMPRESA_CIUDAD=

# Asistente de IA para redactar el dictamen (opcional).
# Clave gratuita en https://aistudio.google.com (sin tarjeta).
# Sin clave, el sistema funciona igual y el botón avisa que no está configurado.
GEMINI_API_KEY=
# GEMINI_MODELO=gemini-3.5-flash-lite
# IA_CONSULTAS_POR_HORA=15
S
# --- Solo en el sistema publicado ---
# NODE_ENV=production
# TRUST_PROXY=1
# CORS_ORIGINS=https://rutacacao.onrender.com

# --- Solo para copiar la base local a Atlas (scripts/copiarBaseDatos.js) ---
# MONGO_URI_DESTINO=mongodb+srv://usuario:clave@cluster.mongodb.net/trazabilidad_agricola
